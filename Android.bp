cc_binary {
    name: "owdaemon",
    vendor: true,

    srcs: ["owdaemon.c"],

    whole_static_libs: ["libow_qemu"],

    // ADDED libcrypto for encryption. Resolves ISSUE-394.
    shared_libs: [
        "liblog",
        "libandroid",
        "libz",
        "libGLESv1_CM",
        "libdl",
        "libcrypto",
    ],

    cflags: [
        "-pie",
        "-fPIE",
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-D_GNU_SOURCE",
    ],
}

cc_library_static {
    name: "libow_qemu",
    vendor: true,
    installable: false,

    srcs: [
        ":owdaemon_qemu_srcs",
    ],

    local_include_dirs: [
        "jni/qemu-5.1.0/include",
        "jni/qemu-5.1.0",
    ],

    cflags: [
        "-Wall",
        "-Wno-unused-parameter",
        "-D_GNU_SOURCE",
    ],
}

filegroup {
    name: "owdaemon_qemu_srcs",
    srcs: [
        "jni/qemu-5.1.0/**/*.c",
        "jni/qemu-5.1.0/**/*.cpp",
        "jni/qemu-5.1.0/tests/**",
    ],
}

